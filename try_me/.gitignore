# Runtime artifacts from actually running this example (tofu init/plan/
# apply) - regenerated locally by anyone who tries it, never meant to be
# committed.
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*

# Convenience symlink to the locally-built multiform binary - points
# outside the repo checkout, never meant to be committed (same as the
# old `tofu` symlink it replaced).
/multiform
